{
  "name": "cvlt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "mkdir -p db media .backups logs && rm -rf .next/standalone/db .next/standalone/media 2>/dev/null && [ -f db/payload.db ] && cp db/payload.db \".backups/payload.db.$(date +%Y_%m_%d_%H%M%S)\" || true && ls -1t .backups/payload.db.* 2>/dev/null | tail -n +31 | xargs rm -f -- 2>/dev/null || true",
    "build": "payload generate:importmap && payload generate:types && next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && ln -sf ../../db .next/standalone/db && ln -sf ../../media .next/standalone/media",
    "build:timed": "bash scripts/build-timed.sh",
    "db:migrate": "payload migrate",
    "db:migrate:status": "payload migrate:status",
    "deploy:timed": "bash scripts/deploy-timed.sh",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.94.1",
    "@payloadcms/live-preview-react": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "fuse.js": "^7.5.0",
    "graphql": "^16.15.0",
    "next": "~16.4.6",
    "nodemailer": "^10.6.1",
    "payload": "3.94.1",
    "payload-totp": "^3.0.7",
    "postcss": "^8.5.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "yet-another-react-lightbox": "^3.33.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@payloadcms/ui": "3.94.1",
    "@payloadcms/translations": "3.94.1",
    "dompurify": "^3.4.18",
    "happy-dom": "21.0.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
